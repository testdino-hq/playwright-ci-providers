# =============================================================================
# TestDino streaming (required)
# =============================================================================
# Your TestDino API token. NEVER commit the real value.
TESTDINO_TOKEN=your_testdino_token
# TestDino server. This repo targets the analytics instance.
TESTDINO_SERVER_URL=https://analytics.testdino.com

# =============================================================================
# API tests (@api) — no secrets needed. Defaults to https://dummyjson.com.
# =============================================================================
# API_BASE_URL=https://dummyjson.com

# =============================================================================
# UI tests (@chromium/@firefox/@webkit/@ios) — need storedemo credentials.
# Without these, the ~21 UI tests fail (but still stream to TestDino).
# The ~29 @api tests pass with no credentials.
# =============================================================================
USERNAME=your_username
PASSWORD=your_password
NEW_PASSWORD=your_new_password
USERNAME1=your_username1

# User profile
FIRST_NAME=John
SFIRST_NAME=Jane

# Billing address
STREET_NAME=Main Street
CITY=New York
STATE=NY
COUNTRY=United States
ZIP_CODE=10001

# Shipping address
SCITY=Los Angeles
SSTATE=CA
SSTREET_ADD=123 Test Street
SZIP_CODE=90210
SCOUNTRY=United States
