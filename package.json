{
  "name": "playwright-ci-providers",
  "version": "1.0.0",
  "description": "Playwright tests against storedemo.testdino.com, wired to stream live to TestDino across every documented CI provider.",
  "scripts": {
    "test": "npx playwright test",
    "test:api": "npx playwright test --project=api",
    "test:nx": "npx nx e2e",
    "test:nx:api": "npx nx e2e --project=api",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@nx/playwright": "^23.1.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "nx": "23.1.0"
  },
  "dependencies": {
    "@testdino/playwright": "file:./testdino-playwright-2.1.0.tgz",
    "dotenv": "^17.2.1",
    "playwright": "^1.55.0"
  },
  "overrides": {
    "chalk": "^4.1.2"
  },
  "nx": {}
}
