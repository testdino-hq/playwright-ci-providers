# Non-secret defaults committed for CI (and local) runs.
# Loaded by playwright.config.js WITHOUT override, so real .env values and CI
# secrets (USERNAME / PASSWORD / NEW_PASSWORD / TESTDINO_TOKEN) always win.
# Secrets never go here — see .env.example / ci/README.md.

# API tests target a public API by default.
API_BASE_URL=https://dummyjson.com

# Profile + address values used by the checkout/order UI tests. Not sensitive.
FIRST_NAME=John
SFIRST_NAME=Jane
STREET_NAME=Main Street
CITY=New York
STATE=NY
COUNTRY=United States
ZIP_CODE=10001
SCITY=Los Angeles
SSTATE=CA
SSTREET_ADD=123 Test Street
SZIP_CODE=90210
SCOUNTRY=United States
